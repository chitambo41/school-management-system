<div class="mb-3">
  <a href="/teacher/classes/<%= classId %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
  <h4 class="fw-bold d-inline ms-2 mb-0">Teacher Comments — <%= cls.name %></h4>
</div>

<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span>Term</span>
    <select name="term" class="form-select form-select-sm" style="min-width:260px" data-filter-form>
      <% terms.forEach(t => { %>
        <option value="<%= t.id %>" <%= String(termId) === String(t.id) ? 'selected' : '' %>><%= t.name %> (<%= t.year %>)</option>
      <% }) %>
    </select>
  </div>
</div>

<form action="/teacher/comments/<%= classId %>" method="POST">
  <input type="hidden" name="term_id" value="<%= termId %>">
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th style="width:30%">Student</th><th>Comment</th></tr></thead>
          <tbody>
            <% if (students.length === 0) { %><tr><td colspan="2" class="text-center text-muted py-4">No students.</td></tr><% } %>
            <% students.forEach(s => { %>
              <tr>
                <td class="fw-semibold"><%= s.name %></td>
                <td>
                  <input type="hidden" name="student_id[]" value="<%= s.id %>">
                  <textarea name="comment[]" class="form-control form-control-sm" rows="2"><%= cMap[s.id] || '' %></textarea>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% if (students.length) { %>
    <button class="btn btn-primary mt-3"><i class="bi bi-save"></i> Save comments</button>
  <% } %>
</form>