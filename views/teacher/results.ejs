<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="fw-bold mb-0"><i class="bi bi-graph-up me-2"></i>Results &amp; Progress</h4>
  <div class="d-flex gap-2">
    <select name="class" class="form-select form-select-sm" data-filter-form style="min-width:160px">
      <% classes.forEach(c => { %>
        <option value="<%= c.id %>" <%= String(classId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
    <select name="term" class="form-select form-select-sm" data-filter-form style="min-width:160px">
      <option value="">All terms</option>
      <% terms.forEach(t => { %>
        <option value="<%= t.id %>" <%= String(termId) === String(t.id) ? 'selected' : '' %>><%= t.name %> (<%= t.year %>)</option>
      <% }) %>
    </select>
  </div>
</div>

<% if (!classId || !termId) { %>
  <div class="text-center text-muted py-5">Select a class and a term to view results.</div>
<% } else { %>
  <% if (results.length === 0) { %>
    <div class="card"><div class="card-body text-center text-muted py-5">No results recorded for this selection.</div></div>
  <% } else { %>
    <div class="mb-3">
      <% const scale = ['A: 81-100','B: 61-80','C: 41-60','D: 21-40','F: 0-20']; %>
      <span class="badge badge-soft-muted">Grade scale: <%= scale.join(' · ') %></span>
    </div>
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Student</th>
                <% results[0] && results[0].marks.forEach(m => { %>
                  <th><%= m.subject_name %></th>
                <% }) %>
                <th>Total</th>
                <th>Average %</th>
              </tr>
            </thead>
            <tbody>
              <% results.forEach(r => { %>
                <tr>
                  <td><span class="badge badge-soft-primary">#<%= r.rank %></span></td>
                  <td class="fw-semibold"><%= r.name %></td>
                  <% r.marks.forEach(m => { %>
                    <td><%= m.marks_obtained %> <span class="badge badge-soft-<%= m.marks_obtained >= 81 ? 'success' : (m.marks_obtained >= 61 ? 'primary' : (m.marks_obtained >= 41 ? 'warning' : 'danger')) %>"><%= m.marks_obtained >= 81 ? 'A' : m.marks_obtained >= 61 ? 'B' : m.marks_obtained >= 41 ? 'C' : m.marks_obtained >= 21 ? 'D' : 'F' %></span></td>
                  <% }) %>
                  <td class="fw-bold"><%= r.total %></td>
                  <td><span class="badge badge-soft-success"><%= r.avg %>%</span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
<% } %>