<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-envelope me-2"></i>Messages</h4>
</div>

<% if (messages.length === 0) { %>
  <div class="card"><div class="card-body text-center text-muted py-5">No messages yet.</div></div>
<% } else { %>
  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead><tr><th>Subject</th><th>From</th><th>Date</th><th></th></tr></thead>
        <tbody>
          <% messages.forEach(m => { %>
            <tr>
              <td>
                <a href="/teacher/messages/<%= m.id %>" class="text-decoration-none <%= m.is_read ? '' : 'fw-bold' %>"><%= m.subject %></a>
                <% if (!m.is_read) { %><span class="badge badge-soft-primary ms-1">New</span><% } %>
              </td>
              <td><%= m.sender_name || 'School Admin' %></td>
              <td class="small text-muted"><%= fmtDateTime(m.created_at) %></td>
              <td class="text-end">
                <a href="/teacher/messages/<%= m.id %>" class="btn btn-sm btn-outline-primary">Open</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>