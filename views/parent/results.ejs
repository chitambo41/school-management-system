<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div class="d-flex gap-2 align-items-center">
    <select name="child" class="form-select form-select-sm" data-filter-form style="min-width:160px">
      <% children.forEach(c => { %>
        <option value="<%= c.id %>" <%= String(childId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
    <% if (terms.length) { %>
      <select name="term" class="form-select form-select-sm" data-filter-form style="min-width:160px">
        <% terms.forEach(t => { %>
          <option value="<%= t.id %>" <%= String(termId) === String(t.id) ? 'selected' : '' %>><%= t.name %> (<%= t.year %>)</option>
        <% }) %>
      </select>
    <% } %>
  </div>
  <% if (childId && termId) { %>
    <div class="d-flex gap-2">
      <% if (reportApproved) { %>
        <a href="/parent/report/<%= childId %>/download" class="btn btn-sm btn-success"><i class="bi bi-file-earmark-pdf"></i> Download PDF</a>
      <% } %>
      <button onclick="window.print()" class="btn btn-sm btn-primary"><i class="bi bi-printer"></i> Print</button>
    </div>
  <% } %>
</div>

<% if (children.length === 0) { %>
  <div class="card"><div class="card-body text-center text-muted py-5">No children linked to your account.</div></div>
<% } else if (!termId) { %>
  <div class="card"><div class="card-body text-center text-muted py-5">No results found for this child yet.</div></div>
<% } else if (marks.length === 0) { %>
  <div class="card"><div class="card-body text-center text-muted py-5">No results available for this selection yet.</div></div>
<% } else { %>
  <div class="card" id="report-card">
    <div class="card-body">
      <div class="text-center mb-4">
        <img src="/images/logo.jpg" alt="School" style="height:60px" class="mb-2">
        <h4 class="fw-bold mb-0">Opportunity School</h4>
        <div class="text-muted small">Academic Report Card</div>
      </div>

      <div class="row g-2 mb-4 p-3 bg-light rounded">
        <div class="col-md-3"><strong>Student:</strong> <%= studentName %></div>
        <div class="col-md-3"><strong>Admission No:</strong> <%= admissionNo %></div>
        <div class="col-md-3"><strong>Class:</strong> <%= className || '—' %></div>
        <div class="col-md-3"><strong>Class Teacher:</strong> <%= classTeacher || '—' %></div>
      </div>

      <% if (reportApproved) { %>
        <div class="alert alert-success py-2 small mb-3"><i class="bi bi-patch-check"></i> Report approved by school.</div>
      <% } %>

      <div class="table-responsive">
        <table class="table table-bordered mb-3">
          <thead class="table-light">
            <tr><th>Subject</th><th>Exam</th><th>Marks</th><th>Grade</th><th>Remarks</th></tr>
          </thead>
          <tbody>
            <% marks.forEach(m => { %>
              <tr>
                <td class="fw-semibold"><%= m.subject_name %></td>
                <td class="small"><%= m.exam_name %></td>
                <td><%= m.marks_obtained %>/<%= m.max_marks %></td>
                <td><span class="badge badge-soft-primary"><%= m.grade %></span></td>
                <td class="small"><%= m.remarks || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot class="table-light">
            <tr>
              <td colspan="2" class="fw-bold">Total</td>
              <td class="fw-bold"><%= total %>/<%= max %></td>
              <td colspan="2">
                Average: <strong><%= max ? Math.round((total / max) * 100 * 10) / 10 : 0 %>%</strong>
                <span class="badge badge-soft-primary ms-2 fs-6"><%= overallGrade %></span>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <% if (position > 0) { %>
        <div class="mb-3 p-3 bg-light rounded text-center">
          <span class="text-muted">Position in <strong><%= className %></strong>:</span>
          <span class="fw-bold text-primary fs-5 ms-2"><%= position %>/<%= totalStudents %></span>
        </div>
      <% } %>

      <div class="border-top pt-3">
        <h6 class="fw-bold"><i class="bi bi-chat-left-text me-1"></i>Class Teacher's Comment</h6>
        <% if (teacherComment) { %>
          <div class="p-3 bg-light rounded fst-italic">"<%= teacherComment %>"</div>
        <% } else { %>
          <div class="text-muted small fst-italic">No comment from the class teacher yet.</div>
        <% } %>
      </div>
    </div>
  </div>
<% } %>