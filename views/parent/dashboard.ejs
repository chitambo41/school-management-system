<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-0 greeting">
      <%
        const hour = new Date().getHours();
        const greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
      %>
      <%= greeting %>, <%= currentUser.name.split(' ')[0] %>
    </h4>
    <p class="text-muted small mb-0 mt-1">Track your children's academic progress here.</p>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="stat-card stat-blue">
      <div class="stat-icon"><i class="bi bi-people"></i></div>
      <div><div class="num"><%= children.length %></div><div class="lbl">Children enrolled</div></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card stat-green">
      <div class="stat-icon"><i class="bi bi-clipboard-check"></i></div>
      <div><div class="num"><%= applications.length %></div><div class="lbl">Applications</div></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card stat-orange">
      <div class="stat-icon"><i class="bi bi-envelope"></i></div>
      <div><div class="num"><%= messages.length %></div><div class="lbl">Recent messages</div></div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header"><i class="bi bi-people me-2 text-primary"></i>My Children</div>
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Name</th><th>Class</th><th>Teacher</th><th></th></tr></thead>
          <tbody>
            <% if (children.length === 0) { %>
              <tr><td colspan="4"><div class="empty-state"><i class="bi bi-person-plus"></i><p>No children enrolled yet.<br>Use "Apply for Admission" to get started.</p></div></td></tr>
            <% } %>
            <% children.forEach(c => { %>
              <tr>
                <td class="fw-semibold"><%= c.name %></td>
                <td><%= c.class_name || 'Not assigned' %></td>
                <td class="small">
                  <%= c.class_teacher || '—' %>
                  <% if (c.class_teacher_phone) { %>
                    <div><a href="tel:<%= c.class_teacher_phone %>" class="text-decoration-none"><i class="bi bi-telephone"></i> <%= c.class_teacher_phone %></a></div>
                  <% } %>
                </td>
                <td class="text-end"><a href="/parent/children/<%= c.id %>" class="btn btn-sm btn-outline-primary">Profile</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card mb-4">
      <div class="card-header"><i class="bi bi-clipboard-check me-2 text-success"></i>Recent Applications</div>
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Student</th><th>Grade</th><th>Status</th><th>Date</th></tr></thead>
          <tbody>
            <% if (applications.length === 0) { %><tr><td colspan="4"><div class="empty-state"><i class="bi bi-inbox"></i><p>No applications.</p></div></td></tr><% } %>
            <% applications.forEach(a => { %>
              <tr>
                <td><%= a.student_name %></td>
                <td><%= a.grade_applying %></td>
                <td>
                  <% if (a.status === 'approved') { %><span class="badge badge-soft-success">Approved</span><% } %>
                  <% if (a.status === 'pending') { %><span class="badge badge-soft-warning">Pending</span><% } %>
                  <% if (a.status === 'rejected') { %><span class="badge badge-soft-danger">Rejected</span><% } %>
                </td>
                <td class="small text-muted"><%= fmtDate(a.created_at) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-envelope me-2 text-warning"></i>Recent Messages</span>
        <a href="/parent/messages" class="btn btn-sm btn-outline-primary">View all</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Subject</th><th>Status</th><th>Date</th></tr></thead>
          <tbody>
            <% if (messages.length === 0) { %><tr><td colspan="3"><div class="empty-state"><i class="bi bi-envelope-open"></i><p>No messages.</p></div></td></tr><% } %>
            <% messages.forEach(m => { %>
              <tr>
                <td>
                  <a href="/parent/messages/<%= m.id %>" class="text-decoration-none <%= !m.is_read ? 'fw-bold' : '' %>"><%= m.subject %></a>
                </td>
                <td>
                  <% if (m.is_read) { %><span class="badge badge-soft-muted">Read</span><% } %>
                  <% if (!m.is_read) { %><span class="badge badge-soft-primary">New</span><% } %>
                </td>
                <td class="small text-muted"><%= fmtDate(m.created_at) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>
</div>