<div class="mb-3">
  <a href="/parent/children" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <div class="text-center mb-2">
          <div class="display-5"><i class="bi bi-person-circle text-primary"></i></div>
          <h4 class="mb-0"><%= student.name %></h4>
          <div class="text-muted small"><%= student.admission_no %></div>
        </div>
        <hr>
        <dl class="small mb-2">
          <dt>Date of birth</dt><dd><%= fmtDate(student.date_of_birth) %></dd>
          <dt>Gender</dt><dd class="text-capitalize"><%= student.gender %></dd>
          <dt>Enrollment date</dt><dd><%= fmtDate(student.enrollment_date) %></dd>
        </dl>

        <h6 class="fw-bold mt-3">Current class & class teacher</h6>
        <% if (currentClass && currentClass.class_name) { %>
          <div class="small mb-1"><i class="bi bi-bank me-1"></i><%= currentClass.class_name %></div>
          <div class="small"><i class="bi bi-person me-1"></i><%= currentClass.class_teacher || 'No class teacher assigned yet' %></div>
          <% if (currentClass.class_teacher_phone) { %>
            <div class="small mt-1">
              <i class="bi bi-telephone me-1"></i><a href="tel:<%= currentClass.class_teacher_phone %>" class="text-decoration-none"><%= currentClass.class_teacher_phone %></a>
            </div>
          <% } %>
        <% } else { %>
          <div class="small text-muted">Not yet in a class for the active academic year.</div>
        <% } %>

        <h6 class="fw-bold mt-3">Class enrollments</h6>
        <% if (enrollments.length === 0) { %><div class="small text-muted">Not enrolled in any class yet.</div><% } %>
        <% enrollments.forEach(e => { %>
          <div class="d-flex justify-content-between small border-bottom py-1">
            <span><%= e.class_name %></span><span class="text-muted"><%= e.term_name %></span>
          </div>
        <% }) %>

        <a href="/parent/results?child=<%= student.id %>" class="btn btn-sm btn-outline-primary w-100 mt-3"><i class="bi bi-graph-up"></i> View results</a>
        <a href="/parent/progress?child=<%= student.id %>" class="btn btn-sm btn-outline-secondary w-100 mt-2"><i class="bi bi-bar-chart"></i> Academic progress</a>
        <% if (student.report_approved_at) { %>
          <a href="/parent/report/<%= student.id %>/download" class="btn btn-sm btn-success w-100 mt-2"><i class="bi bi-file-earmark-pdf"></i> Download full report (PDF)</a>
        <% } else { %>
          <div class="small text-muted text-center mt-2"><i class="bi bi-hourglass-split"></i> Full report available once approved by the school.</div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card mb-4">
      <div class="card-header">Attendance Summary</div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead><tr><th>Status</th><th>Days</th></tr></thead>
          <tbody>
            <% if (attendance.length === 0) { %><tr><td colspan="2" class="text-muted">No attendance recorded.</td></tr><% } %>
            <% attendance.forEach(a => { %>
              <tr>
                <td class="text-capitalize">
                  <% if (a.status === 'present') { %><span class="badge badge-soft-success">Present</span><% } %>
                  <% if (a.status === 'absent') { %><span class="badge badge-soft-danger">Absent</span><% } %>
                  <% if (a.status === 'late') { %><span class="badge badge-soft-warning">Late</span><% } %>
                  <% if (a.status === 'excused') { %><span class="badge badge-soft-muted">Excused</span><% } %>
                </td>
                <td><%= a.c %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">Term Results</div>
      <div class="card-body p-0">
        <% terms.forEach(term => { %>
          <h6 class="px-3 pt-3 fw-bold text-primary"><%= term.name %> (<%= term.year %>)</h6>
          <table class="table table-sm mb-0">
            <thead><tr><th>Subject</th><th>Marks</th><th>Grade</th><th>Remarks</th></tr></thead>
            <tbody>
              <% const tr = termResults[term.id]; %>
              <% if (tr && tr.marks.length) { %>
                <% tr.marks.forEach(m => { %>
                  <tr>
                    <td><%= m.subject_name %></td>
                    <td><%= m.marks_obtained %>/<%= m.max_marks %></td>
                    <td><span class="badge badge-soft-primary"><%= m.grade %></span></td>
                    <td class="small"><%= m.remarks || '—' %></td>
                  </tr>
                <% }) %>
                <tr class="table-light">
                  <td class="fw-bold">Total</td>
                  <td class="fw-bold"><%= tr.total %>/<%= tr.max %></td>
                  <td colspan="2">Average: <span class="badge badge-soft-success"><%= tr.avg %>%</span></td>
                </tr>
              <% } else { %>
                <tr><td colspan="4" class="text-muted">No results yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        <% }) %>
        <% if (terms.length === 0) { %>
          <div class="text-center text-muted py-4">No results recorded yet.</div>
        <% } %>
      </div>
    </div>
  </div>
</div>