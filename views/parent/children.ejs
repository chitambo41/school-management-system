<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>My Children</h4>
</div>

<% if (children.length === 0) { %>
  <div class="card"><div class="card-body text-center text-muted py-5">
    No children linked to your account yet.<br>
    <a href="/parent/apply" class="btn btn-primary btn-sm mt-3">Apply for admission</a>
  </div></div>
<% } else { %>
  <div class="row g-3">
    <% children.forEach(c => { %>
      <div class="col-md-4">
        <div class="card">
          <div class="card-body text-center">
            <div class="display-6 mb-2"><i class="bi bi-person-circle text-primary"></i></div>
            <h5 class="mb-0"><a href="/parent/children/<%= c.id %>" class="text-decoration-none"><%= c.name %></a></h5>
            <div class="text-muted small mb-1"><%= c.admission_no %></div>
            <div class="small"><i class="bi bi-bank me-1"></i><%= c.class_name || 'Not assigned to a class' %></div>
            <div class="small mb-2">
              <i class="bi bi-person me-1"></i><%= c.class_teacher || 'No class teacher yet' %>
              <% if (c.class_teacher_phone) { %> · <a href="tel:<%= c.class_teacher_phone %>" class="text-decoration-none"><i class="bi bi-telephone"></i> <%= c.class_teacher_phone %></a><% } %>
            </div>
            <span class="badge <%= c.status === 'active' ? 'badge-soft-success' : 'badge-soft-muted' %>"><%= c.status %></span>
            <div class="mt-3 d-flex justify-content-center gap-2">
              <a href="/parent/children/<%= c.id %>" class="btn btn-sm btn-outline-primary">View profile</a>
              <% if (c.report_approved_at) { %>
                <a href="/parent/report/<%= c.id %>/download" class="btn btn-sm btn-success"><i class="bi bi-file-earmark-pdf"></i> Report PDF</a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>