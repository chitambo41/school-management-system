<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-clipboard-check me-2"></i>My Applications</h4>
  <a href="/parent/apply" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New application</a>
</div>

<% if (applications.length === 0) { %>
  <div class="card"><div class="card-body text-center text-muted py-5">
    You have not submitted any applications yet.<br>
    <a href="/parent/apply" class="btn btn-primary btn-sm mt-3">Apply for admission</a>
  </div></div>
<% } else { %>
  <div class="row g-3">
    <% applications.forEach(a => { %>
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="mb-0 fw-bold"><%= a.student_name %></h6>
              <% if (a.status === 'approved') { %><span class="badge badge-soft-success">Approved</span><% } %>
              <% if (a.status === 'pending') { %><span class="badge badge-soft-warning">Pending</span><% } %>
              <% if (a.status === 'rejected') { %><span class="badge badge-soft-danger">Rejected</span><% } %>
            </div>
            <table class="table table-sm small mb-2">
              <tr><td class="text-muted">Grade applying</td><td><%= a.grade_applying %></td></tr>
              <tr><td class="text-muted">Submitted</td><td><%= fmtDateTime(a.created_at) %></td></tr>
            </table>
            <% if (a.admin_note) { %>
              <div class="alert alert-info py-1 px-2 mb-0 small"><i class="bi bi-info-circle"></i> <%= a.admin_note %></div>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>