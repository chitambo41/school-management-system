<div class="mb-3">
  <a href="/parent/messages" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
  <div class="card-body">
    <h5 class="fw-bold"><%= msg.subject %></h5>
    <div class="small text-muted mb-3">
      From: <%= msg.sender_name || 'Opportunity School Admin' %> · <%= fmtDateTime(msg.created_at) %>
    </div>
    <div style="white-space: pre-line"><%= msg.body %></div>
  </div>
</div>