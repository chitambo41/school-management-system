<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-journal-text me-2"></i>Activity Logs</h4>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr><th>When</th><th>User</th><th>Action</th><th>Description</th><th>IP</th></tr>
        </thead>
        <tbody>
          <% if (logs.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4">No activity recorded yet.</td></tr><% } %>
          <% logs.forEach(l => { %>
            <tr>
              <td class="small text-muted"><%= fmtDateTime(l.created_at) %></td>
              <td><%= l.user_name || 'System' %></td>
              <td><code class="small"><%= l.action %></code></td>
              <td class="small"><%= l.description || '—' %></td>
              <td class="small text-muted"><%= l.ip_address || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>