<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-clipboard-check me-2"></i>Admission Applications</h4>
  <div class="btn-group">
    <a href="/admin/applications" class="btn btn-sm <%= !status ? 'btn-primary' : 'btn-outline-primary' %>">All</a>
    <a href="/admin/applications?status=pending" class="btn btn-sm <%= status === 'pending' ? 'btn-primary' : 'btn-outline-primary' %>">Pending</a>
    <a href="/admin/applications?status=approved" class="btn btn-sm <%= status === 'approved' ? 'btn-primary' : 'btn-outline-primary' %>">Approved</a>
    <a href="/admin/applications?status=rejected" class="btn btn-sm <%= status === 'rejected' ? 'btn-primary' : 'btn-outline-primary' %>">Rejected</a>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>Student</th><th>Parent</th><th>Grade</th><th>Applied</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No applications found.</td></tr>
        <% } %>
        <% rows.forEach(a => { %>
          <tr>
            <td class="fw-semibold"><%= a.student_name %></td>
            <td><%= a.parent_name %><div class="small text-muted"><%= a.parent_email %></div></td>
            <td><%= a.grade_applying %></td>
            <td class="small"><%= fmtDate(a.created_at) %></td>
            <td>
              <% if (a.status === 'approved') { %><span class="badge badge-soft-success">Approved</span><% } %>
              <% if (a.status === 'pending') { %><span class="badge badge-soft-warning">Pending</span><% } %>
              <% if (a.status === 'rejected') { %><span class="badge badge-soft-danger">Rejected</span><% } %>
            </td>
            <td class="text-end"><a href="/admin/applications/<%= a.id %>" class="btn btn-sm btn-outline-primary">Review</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>