<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-calendar3 me-2"></i>Academic Years &amp; Terms</h4>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">New Academic Year</div>
      <div class="card-body">
        <form action="/admin/academic-years" method="POST">
          <div class="mb-2">
            <label class="form-label small">Name *</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. 2026-2027" required>
          </div>
          <div class="row g-2 mb-3">
            <div class="col"><label class="form-label small">Start date</label><input type="date" name="start_date" class="form-control" required></div>
            <div class="col"><label class="form-label small">End date</label><input type="date" name="end_date" class="form-control" required></div>
          </div>
          <button class="btn btn-primary w-100">Create year</button>
        </form>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">Add Term</div>
      <div class="card-body">
        <form action="/admin/terms" method="POST">
          <div class="mb-2">
            <label class="form-label small">Academic year</label>
            <select name="academic_year_id" class="form-select" required>
              <% years.forEach(y => { %>
                <option value="<%= y.id %>"><%= y.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small">Term name *</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Term 1" required>
          </div>
          <div class="row g-2 mb-3">
            <div class="col"><label class="form-label small">Start</label><input type="date" name="start_date" class="form-control"></div>
            <div class="col"><label class="form-label small">End</label><input type="date" name="end_date" class="form-control"></div>
          </div>
          <button class="btn btn-primary w-100">Create term</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <% years.forEach(y => { %>
      <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <%= y.name %>
          <div>
            <% if (y.is_active) { %>
              <span class="badge badge-soft-success me-2">Active</span>
            <% } else { %>
              <form action="/admin/academic-years/<%= y.id %>/activate" method="POST" class="d-inline">
                <button class="btn btn-sm btn-outline-primary">Set active</button>
              </form>
            <% } %>
          </div>
        </div>
        <div class="card-body">
          <div class="small text-muted mb-2"><%= fmtDate(y.start_date) %> → <%= fmtDate(y.end_date) %></div>
          <% if (y.terms.length === 0) { %><div class="small text-muted">No terms yet.</div><% } %>
          <% y.terms.forEach(t => { %>
            <% if (t.is_active) { %>
              <span class="badge badge-soft-success me-1"><i class="bi bi-check-circle"></i> <%= t.name %> (active)</span>
            <% } else { %>
              <form action="/admin/terms/<%= t.id %>/activate" method="POST" class="d-inline me-1">
                <button class="btn btn-sm btn-outline-primary" title="Make this the active term"><%= t.name %></button>
              </form>
            <% } %>
          <% }) %>
        </div>
      </div>
    <% }) %>
    <% if (years.length === 0) { %>
      <div class="text-center text-muted py-5">No academic years yet. Create one on the left.</div>
    <% } %>
  </div>
</div>