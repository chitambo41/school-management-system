<div class="mb-3">
  <a href="/admin/students" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
  <div class="card-header"><%= student ? 'Edit Student' : 'Add Student' %></div>
  <div class="card-body">
    <form action="<%= student ? '/admin/students/' + student.id : '/admin/students' %>" method="POST">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Full name *</label>
          <input type="text" name="name" value="<%= student ? student.name : '' %>" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Parent / Guardian</label>
          <select name="parent_user_id" class="form-select">
            <option value="">— None —</option>
            <% parents.forEach(p => { %>
              <option value="<%= p.id %>" <%= student && student.parent_user_id == p.id ? 'selected' : '' %>><%= p.name %> (<%= p.email %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Class (enroll)</label>
          <select name="class_id" class="form-select">
            <option value="">— None —</option>
            <% classes.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(currentClassId || '') === String(c.id) ? 'selected' : '' %>><%= c.name %> <%= c.section || '' %></option>
            <% }) %>
          </select>
          <% if (student && currentClassId) { %>
            <div class="form-text text-success"><i class="bi bi-check-circle"></i> Current class: <%= student ? (classes.find(x => String(x.id) === String(currentClassId)) || {}).name : '' %> — changing it moves this student to the selected class.</div>
          <% } %>
        </div>
        <div class="col-md-4">
          <label class="form-label">Date of birth *</label>
          <input type="date" name="date_of_birth" value="<%= student ? student.date_of_birth : '' %>" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Gender *</label>
          <select name="gender" class="form-select" required>
            <option value="female" <%= student && student.gender === 'female' ? 'selected' : '' %>>Female</option>
            <option value="male" <%= student && student.gender === 'male' ? 'selected' : '' %>>Male</option>
            <option value="other" <%= student && student.gender === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Address</label>
          <input type="text" name="address" value="<%= student ? student.address || '' : '' %>" class="form-control">
        </div>
        <div class="col-md-6">
          <label class="form-label">Previous school</label>
          <input type="text" name="previous_school" value="<%= student ? student.previous_school || '' : '' %>" class="form-control">
        </div>
        <% if (student) { %>
          <div class="col-md-4">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
              <% ['active','graduated','transferred','dropped'].forEach(st => { %>
                <option value="<%= st %>" <%= student.status === st ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
        <div class="col-12 mt-3">
          <button class="btn btn-primary"><%= student ? 'Save changes' : 'Create student' %></button>
        </div>
      </div>
    </form>
  </div>
</div>