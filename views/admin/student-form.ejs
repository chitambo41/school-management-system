<div class="mb-3">
  <a href="/admin/students" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card">
  <div class="card-header"><%= student ? 'Edit Student' : 'Add Student' %></div>
  <div class="card-body">
    <form action="<%= student ? '/admin/students/' + student.id : '/admin/students' %>" method="POST">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Full name *</label>
          <input type="text" name="name" value="<%= student ? student.name : '' %>" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Parent / Guardian</label>
          <% const hasParent = student && student.parent_user_id; const hasGuardian = student && student.guardian_name && !student.parent_user_id; %>
          <div class="d-flex gap-3 mb-2">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="parent_mode" id="modeType" value="type" <%= !hasParent ? 'checked' : '' %>>
              <label class="form-check-label" for="modeType">Type name</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="parent_mode" id="modeSelect" value="select" <%= hasParent ? 'checked' : '' %>>
              <label class="form-check-label" for="modeSelect">Select registered parent</label>
            </div>
          </div>
          <div id="typeField">
            <input type="text" name="guardian_name" id="guardianNameInput" value="<%= student ? student.guardian_name || '' : '' %>" class="form-control" placeholder="e.g. John Davis">
          </div>
          <div id="selectField" style="display:<%= hasParent ? 'block' : 'none' %>">
            <select name="parent_user_id" id="parentSelect" class="form-select">
              <option value="">— None —</option>
              <% parents.forEach(p => { %>
                <option value="<%= p.id %>" data-name="<%= p.name %>" <%= student && student.parent_user_id == p.id ? 'selected' : '' %>><%= p.name %> (<%= p.email %>)</option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Class (enroll)</label>
          <select name="class_id" class="form-select">
            <option value="">— None —</option>
            <% classes.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(currentClassId || '') === String(c.id) ? 'selected' : '' %>><%= c.name %> <%= c.section || '' %></option>
            <% }) %>
          </select>
          <% if (student && currentClassId) { %>
            <div class="form-text text-success"><i class="bi bi-check-circle"></i> Current class: <%= student ? (classes.find(x => String(x.id) === String(currentClassId)) || {}).name : '' %> — changing it moves this student to the selected class.</div>
          <% } %>
        </div>
        <div class="col-md-4">
          <label class="form-label">Date of birth *</label>
          <input type="date" name="date_of_birth" value="<%= student ? student.date_of_birth : '' %>" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Gender *</label>
          <select name="gender" class="form-select" required>
            <option value="female" <%= student && student.gender === 'female' ? 'selected' : '' %>>Female</option>
            <option value="male" <%= student && student.gender === 'male' ? 'selected' : '' %>>Male</option>
            <option value="other" <%= student && student.gender === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Address</label>
          <input type="text" name="address" value="<%= student ? student.address || '' : '' %>" class="form-control">
        </div>
        <div class="col-md-6">
          <label class="form-label">Previous school</label>
          <input type="text" name="previous_school" value="<%= student ? student.previous_school || '' : '' %>" class="form-control">
        </div>
        <% if (student) { %>
          <div class="col-md-4">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
              <% ['active','graduated','transferred','dropped'].forEach(st => { %>
                <option value="<%= st %>" <%= student.status === st ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
        <div class="col-12 mt-3">
          <button class="btn btn-primary"><%= student ? 'Save changes' : 'Create student' %></button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modeType = document.getElementById('modeType');
  const modeSelect = document.getElementById('modeSelect');
  const typeField = document.getElementById('typeField');
  const selectField = document.getElementById('selectField');
  const parentSelect = document.getElementById('parentSelect');
  const guardianInput = document.getElementById('guardianNameInput');

  function toggle() {
    if (modeType.checked) {
      typeField.style.display = 'block';
      selectField.style.display = 'none';
      parentSelect.value = '';
    } else {
      typeField.style.display = 'none';
      selectField.style.display = 'block';
      guardianInput.value = '';
    }
  }
  modeType.addEventListener('change', toggle);
  modeSelect.addEventListener('change', toggle);

  parentSelect.addEventListener('change', function() {
    const opt = parentSelect.options[parentSelect.selectedIndex];
    if (opt && opt.dataset.name) guardianInput.value = opt.dataset.name;
  });
});
</script>