<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-graph-up me-2"></i>Results by Class</h4>
  <% if (cls && classId && termId) { %>
    <div class="d-flex gap-2">
      <% if (studentId) { %>
        <a href="/admin/results/print?class=<%= classId %>&term=<%= termId %>&student=<%= studentId %>" class="btn btn-primary btn-sm" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>Print this student</a>
      <% } %>
      <a href="/admin/results/print?class=<%= classId %>&term=<%= termId %>" class="btn btn-primary btn-sm" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>Print whole class</a>
    </div>
  <% } %>
</div>

<form class="card card-body mb-3" action="/admin/results" method="GET">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="form-label small">Class</label>
      <select name="class" class="form-select form-select-sm" data-filter-form>
        <% classes.forEach(c => { %>
          <option value="<%= c.id %>" <%= String(classId) === String(c.id) ? 'selected' : '' %>><%= c.name %> <%= c.section || '' %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label small">Term</label>
      <select name="term" class="form-select form-select-sm" data-filter-form>
        <% terms.forEach(t => { %>
          <option value="<%= t.id %>" <%= String(termId) === String(t.id) ? 'selected' : '' %>><%= t.name %> (<%= t.year %>)</option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label small">Student</label>
      <select name="student" class="form-select form-select-sm" data-filter-form>
        <option value="" <%= !studentId ? 'selected' : '' %>>All students</option>
        <% rows.forEach(r => { %>
          <option value="<%= r.id %>" <%= String(studentId) === String(r.id) ? 'selected' : '' %>><%= r.name %></option>
        <% }) %>
      </select>
    </div>
  </div>
</form>

<% if (cls && classId && termId) { %>
  <div class="card mb-3 border-0 shadow-sm">
    <div class="card-body py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <% if (!submission || submission.status === 'draft') { %>
          <span class="badge badge-soft-muted">Not confirmed by class teacher yet</span>
          <div class="small text-muted mt-1">Wait for the class teacher to confirm the results before printing.</div>
        <% } else if (submission.status === 'submitted') { %>
          <span class="badge badge-soft-warning">Submitted — awaiting your review</span>
          <div class="small text-muted mt-1">Confirmed by <strong><%= submission.submitted_by_name || '—' %></strong><% if (submission.submitted_at) { %> on <%= new Date(submission.submitted_at).toLocaleString() %><% } %>.</div>
        <% } else if (submission.status === 'approved') { %>
          <span class="badge badge-soft-success">Approved &amp; ready to print</span>
          <div class="small text-muted mt-1">Reviewed by <strong><%= submission.reviewed_by_name || 'you' %></strong><% if (submission.reviewed_at) { %> on <%= new Date(submission.reviewed_at).toLocaleString() %><% } %>.</div>
        <% } else { %>
          <span class="badge badge-soft-danger">Changes requested — teacher must resubmit</span>
          <% if (submission.admin_note) { %><div class="small text-muted mt-1">Your note: <%= submission.admin_note %></div><% } %>
        <% } %>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <% if (submission && (submission.status === 'submitted' || submission.status === 'revision')) { %>
          <form action="/admin/results/approve" method="POST" class="d-inline">
            <input type="hidden" name="class" value="<%= classId %>">
            <input type="hidden" name="term" value="<%= termId %>">
            <button class="btn btn-success btn-sm"><i class="bi bi-check2-circle me-1"></i>Approve &amp; print</button>
          </form>
        <% } %>
        <% if (submission && submission.status !== 'draft') { %>
          <form action="/admin/results/revision" method="POST" class="d-inline">
            <input type="hidden" name="class" value="<%= classId %>">
            <input type="hidden" name="term" value="<%= termId %>">
            <button class="btn btn-outline-warning btn-sm"><i class="bi bi-arrow-counterclockwise me-1"></i>Request changes</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
<% } %>

<% if (!cls) { %>
  <div class="text-center text-muted py-5">No classes yet. <a href="/admin/classes/new">Create a class</a> to see results.</div>
<% } else if (studentId && displayRows.length === 0) { %>
  <div class="card"><div class="card-body text-center text-muted py-4">The selected student is not enrolled in this class.</div></div>
<% } else { %>
  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span><%= cls.name %> <%= cls.section || '' %> · Term results</span>
      <% if (cls.teacher_name) { %><span class="small text-muted">Class teacher: <strong><%= cls.teacher_name %></strong></span><% } %>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-bordered mb-0 small text-center align-middle">
          <thead>
            <tr>
              <th style="min-width:50px">Pos</th>
              <th class="text-start" style="min-width:180px">Student</th>
              <% subjects.forEach(su => { %>
                <th><%= su.name %><br><span class="fw-normal text-muted" style="font-size:.72rem"><%= su.teacher_name || '' %></span></th>
              <% }) %>
              <th>Total</th>
              <th>%</th>
              <th>Grade</th>
            </tr>
          </thead>
          <tbody>
            <% if (displayRows.length === 0) { %>
              <tr><td colspan="<%= subjects.length + 5 %>" class="text-center text-muted py-4">No students enrolled in this class.</td></tr>
            <% } %>
            <% displayRows.forEach(r => { %>
              <tr class="<%= studentId && String(studentId) === String(r.id) ? 'table-primary' : '' %>">
                <td>
                  <% if (r.position) { %>
                    <span class="badge <%= r.position === 1 ? 'badge-soft-success' : (r.position === 2 || r.position === 3 ? 'badge-soft-primary' : 'badge-soft-muted') %>">#<%= r.position %></span>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
                <td class="text-start">
                  <div class="fw-semibold"><a href="/admin/students/<%= r.id %>" class="text-decoration-none"><%= r.name %></a></div>
                  <div class="text-muted small"><%= r.admission_no %></div>
                  <a href="/admin/results/print?class=<%= classId %>&term=<%= termId %>&student=<%= r.id %>" target="_blank" class="btn btn-sm btn-outline-primary mt-1 py-0 px-2" title="Print this student's results"><i class="bi bi-printer"></i> Print</a>
                </td>
                <% r.subjects.forEach(sub => { %>
                  <% if (sub.obtained !== null) { %>
                    <td><%= sub.pct %>% <span class="badge badge-soft-primary"><%= sub.grade %></span><br><span class="text-muted" style="font-size:.72rem"><%= sub.obtained %>/<%= sub.max %></span></td>
                  <% } else { %>
                    <td><span class="text-muted">—</span></td>
                  <% } %>
                <% }) %>
                <td class="fw-bold"><%= r.total %></td>
                <td><%= r.pct !== null ? r.pct + '%' : '—' %></td>
                <td><% if (r.grade) { %><span class="badge badge-soft-success"><%= r.grade %></span><% } else { %><span class="text-muted">—</span><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% if (displayRows.length) { %>
      <div class="card-footer small text-muted">
        Marks are entered by each subject teacher. Grading: A (81-100) &bull; B (61-80) &bull; C (41-60) &bull; D (21-40) &bull; F (0-20). Students without marks yet show "—".
      </div>
    <% } %>
  </div>
<% } %>