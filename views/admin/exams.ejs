<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2"></i>Examinations</h4>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">Create Examination</div>
      <div class="card-body">
        <form action="/admin/exams" method="POST">
          <div class="mb-2">
            <label class="form-label small">Exam name *</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. End of Term Exam" required>
          </div>
          <div class="row g-2">
            <div class="col">
              <label class="form-label small">Class</label>
              <select name="class_id" class="form-select" required>
                <% classes.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
              </select>
            </div>
            <div class="col">
              <label class="form-label small">Term</label>
              <select name="term_id" class="form-select" required>
                <% terms.forEach(t => { %><option value="<%= t.id %>"><%= t.name %> (<%= t.year %>)</option><% }) %>
              </select>
            </div>
          </div>
          <div class="row g-2 my-2">
            <div class="col">
              <label class="form-label small">Date</label>
              <input type="date" name="date" class="form-control">
            </div>
            <div class="col">
              <label class="form-label small">Max marks</label>
              <input type="number" name="max_marks" class="form-control" value="100" min="1">
            </div>
          </div>
          <button class="btn btn-primary w-100 mt-2">Create exam</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card">
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead><tr><th>Name</th><th>Class</th><th>Term</th><th>Date</th><th>Max</th><th></th></tr></thead>
          <tbody>
            <% if (exams.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No exams.</td></tr><% } %>
            <% exams.forEach(e => { %>
              <tr>
                <td class="fw-semibold"><%= e.name %></td>
                <td><%= e.class_name %></td>
                <td><%= e.term_name %></td>
                <td class="small"><%= e.date ? fmtDate(e.date) : '—' %></td>
                <td class="small"><%= e.max_marks %></td>
                <td class="text-end">
                  <form action="/admin/exams/<%= e.id %>/delete" method="POST" class="d-inline" onsubmit="return confirmDelete('Delete this exam and its marks?')">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>