<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-link-45deg me-2"></i>Class-Teacher-Subject Assignments</h4>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">New Assignment</div>
      <div class="card-body">
        <form action="/admin/assignments" method="POST">
          <div class="mb-2">
            <label class="form-label small">Class</label>
            <select name="class_id" class="form-select" required>
              <option value="">— select —</option>
              <% classes.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %> <%= c.section || '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small">Teacher</label>
            <select name="teacher_id" class="form-select" required>
              <option value="">— select —</option>
              <% teachers.forEach(t => { %>
                <option value="<%= t.id %>"><%= t.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small">Subject</label>
            <select name="subject_id" class="form-select" required>
              <option value="">— select —</option>
              <% subjects.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% }) %>
            </select>
          </div>
          <button class="btn btn-primary w-100">Assign</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead><tr><th>Class</th><th>Subject</th><th>Teacher</th><th></th></tr></thead>
          <tbody>
            <% if (rows.length === 0) { %><tr><td colspan="4" class="text-center text-muted py-4">No assignments.</td></tr><% } %>
            <% rows.forEach(r => { %>
              <tr>
                <td><%= r.class_name %></td>
                <td><%= r.subject_name %></td>
                <td><%= r.teacher_name %></td>
                <td class="text-end">
                  <form action="/admin/assignments/<%= r.id %>/delete" method="POST" class="d-inline" onsubmit="return confirmDelete()">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>