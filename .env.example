# ============================================
# Opportunity School Management System - Environment
# Copy this file to .env and fill in your values
# ============================================

# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change_this_to_a_long_random_secret_string

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_management
DB_USER=root
DB_PASSWORD=

# Nodemailer (email notifications)
# Use '' to disable emails in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM='"Opportunity School Admin" <no-reply@opportunityschool.com>'

# Base URL (used in emails)
BASE_URL=http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE=5mb
